# Keycloak kapcsolat a landing oldalhoz.
# A weboldal ezek nélkül is működik: ha a Keycloak nem érhető el,
# az oldal névtelen látogatóként rendereldik, csak a bejelentkezés nem megy.

# A Keycloak szerver gyökér URL-je (végén nincs perjel).
VITE_KEYCLOAK_URL=http://localhost:8081

# A realm neve.
VITE_KEYCLOAK_REALM=snitt

# A landing oldalhoz tartozó public client azonosítója (PKCE, standard flow).
VITE_KEYCLOAK_CLIENT_ID=snitt-landing

# Hibajelentés a GlitchTipbe (opcionális). Üresen hagyva ki van kapcsolva: az SDK el sem indul,
# és a csomagba sem kerül be; beállítva is csak külön csomagként töltődik be. Build-időben épül
# be, tehát változtatás után újra kell buildelni.
VITE_SENTRY_DSN=

# A környezet neve az eseményeken. Üresen a Vite módja (dev szerveren development, buildben
# production).
# VITE_SENTRY_ENVIRONMENT=

# A telepítők letöltési helye (végén nincs perjel). Alapértelmezés: https://api.snitt.video/downloads
# - a Snitt szerverén, az edge proxy szolgálja ki; a kiadó workflow tölti fel (snitt repo, docs/KIADAS.md).
# Helyi próbához bármilyen static szerverre mutathat, ami a latest.json-t és a latest/ mappát adja.
VITE_DOWNLOAD_BASE_URL=

# Google Analytics 4 mérési azonosító (opcionális, "G-XXXXXXXXXX" alakú). Üresen hagyva az
# analitika teljesen ki van kapcsolva: a cookie-sáv nem jelenik meg, és a gtag.js script sosem
# töltődik be — jelenleg nincs kiosztott azonosító, tehát ez itt szándékosan üres marad, amíg
# nem lesz egy. Build-időben épül be, tehát változtatás után újra kell buildelni.
VITE_GA_MEASUREMENT_ID=
