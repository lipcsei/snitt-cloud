# Az admin felület konfigurációja. Minden változónak van alapértelmezése,
# ez a fájl a deploy/docker-compose.yml fejlesztői stackhez illik.

# A Keycloak szerver gyökér URL-je (végén nincs perjel).
VITE_KEYCLOAK_URL=http://localhost:8081

# A realm neve.
VITE_KEYCLOAK_REALM=snitt

# Az admin felület publikus kliense (PKCE, standard flow).
VITE_KEYCLOAK_CLIENT_ID=snitt-admin

# Az account szolgáltatás gyökér URL-je (végén nincs perjel).
VITE_API_BASE_URL=http://localhost:8090
