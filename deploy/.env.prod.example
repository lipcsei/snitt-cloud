# Éles környezeti változók sablonja.
#
# HASZNÁLAT: másold "deploy/.env.prod" néven KÖZVETLENÜL A VPS-EN (nem a git
# repóban!), és töltsd ki valódi értékekkel. Ez a fájl SOHA nem kerül
# commitba - lásd .gitignore. A titkokat (jelszavak, kliens secret) generáld
# újra, ne a lenti példaértékekkel indulj élesben.
#
#   cp deploy/.env.prod.example deploy/.env.prod
#   openssl rand -base64 24   # jelszavak generálásához
#   chmod 600 deploy/.env.prod

# --- Domainek ---
# Ezeknek A-rekordként a VPS IP-jére kell mutatniuk, MIELŐTT az edge
# proxyt (https://github.com/lipcsei/edge) elindítod - különben a Let's
# Encrypt tanúsítványkérés elbukik. A címeket ITT csak az admin/landing
# build-argumentumai használják; a proxy a saját .env.prod-jából olvassa.
PUBLIC_KEYCLOAK_URL=https://auth.snitt.video
PUBLIC_API_URL=https://api.snitt.video
PUBLIC_ADMIN_URL=https://admin.snitt.video
# A landing élesben GitHub Pages-en fut - ez csak az admin/landing build
# argumentumaiban szereplő kanonikus URL-ekhez kell, ha mégis buildelnéd itt.
PUBLIC_SITE_URL=https://snitt.video

# --- Postgres ---
# Csak az account szolgáltatás adatai (profilok, előfizetések, számlák).
# A Keycloak SAJÁT adatbázisa és bootstrap admin jelszava a megosztott sso
# repóban van (https://github.com/lipcsei/sso, annak saját .env.prod-ja) -
# nem itt, lásd docs/FIOKOK-ELESITES.md.
POSTGRES_USER=snitt
POSTGRES_PASSWORD=CSERÉLD-LE-egy-erős-jelszóra
POSTGRES_DB=snitt

# --- account szolgáltatás ---
KEYCLOAK_REALM=snitt
# A tokenek "iss" claimjének ezzel kell egyeznie - a böngésző által látott,
# publikus Keycloak-cím, NEM a belső "keycloak:8080" docker-hostnév.
KEYCLOAK_ISSUER=https://auth.snitt.video/realms/snitt
KEYCLOAK_AUDIENCE=snitt-landing,snitt-admin
# A landing (GitHub Pages) és az admin felület valódi domainje - CORS-hoz.
CORS_ORIGINS=https://snitt.video,https://admin.snitt.video
KEYCLOAK_ADMIN_CLIENT_ID=snitt-admin-api
# A sso repó snitt-realm.json-jában szereplő fejlesztői secret helyett
# generálj egy újat a Keycloak admin konzolon (Clients → snitt-admin-api →
# Credentials), és azt írd ide.
KEYCLOAK_ADMIN_CLIENT_SECRET=CSERÉLD-LE
ADMIN_ROLE=admin
DEFAULT_CURRENCY=HUF

# --- admin/landing build argumentumok (Vite, fordításkor épülnek be) ---
ADMIN_CLIENT_ID=snitt-admin
LANDING_CLIENT_ID=snitt-landing

# --- Hibajelentés a GlitchTipbe (opcionális) ---
# Egy DSN projektenként, az éles GlitchTip projekt "Client Keys (DSN)" oldaláról; üres/hiányzó =
# kikapcsolva. Az éles GlitchTip még nincs felállítva, ezért a sorok kikommentelve maradnak: a
# vps/github-env.sh check minden kommentjel nélküli kulcsot kitöltöttnek vár. Ha megvan a DSN,
# vedd le a kommentjelet, írd be, és frissítsd a VPS_ENV secretet.
# Az admin DSN-je build-időben épül a képbe. A landing élesben GitHub Pages-en fut: annak DSN-je
# a SENTRY_DSN_LANDING repository variable (lásd .github/workflows/ci.yml), ide csak akkor kell,
# ha mégis itt buildelnéd.
# SENTRY_DSN_ACCOUNT=
# SENTRY_DSN_ADMIN=
# SENTRY_DSN_LANDING=
