# Éles reverse proxy - automatikus Let's Encrypt tanúsítvánnyal minden
# domainhez. A {$VAR} formátum a caddy konténer saját környezeti
# változóiból helyettesít be (lásd docker-compose.prod.yml "caddy"
# szolgáltatás "environment" blokkja).

{
	email {$ACME_EMAIL}
}

{$PUBLIC_KEYCLOAK_URL} {
	reverse_proxy keycloak:8081
}

{$PUBLIC_API_URL} {
	reverse_proxy account:8090
}

{$PUBLIC_ADMIN_URL} {
	reverse_proxy admin:80
}
