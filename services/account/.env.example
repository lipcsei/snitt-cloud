# Snitt account szolgáltatás - környezeti változók.
# Minden változónak van alapértelmezése, ez a fájl a fejlesztői stackhez illik.

# HTTP figyelési cím.
HTTP_ADDR=:8090

# PostgreSQL kapcsolat. Docker composeban a host neve "postgres".
DATABASE_URL=postgres://snitt:snitt@localhost:5432/snitt?sslmode=disable

# A Keycloak (megosztott szolgáltatás, lásd https://github.com/lipcsei/sso)
# realm issuer URL-je: ennek egyeznie kell a tokenek "iss" claimjével.
KEYCLOAK_ISSUER=http://localhost:8081/realms/snitt

# Opcionális: ha a discovery más címen érhető el, mint az issuer (pl. Dockerben
# a "keycloak" hoszton, az sso-net hálózaton, port 8080 - a Keycloak
# konténer belső HTTP portja). Üresen hagyva a KEYCLOAK_ISSUER értékét
# használja.
# KEYCLOAK_DISCOVERY_URL=http://keycloak:8080/realms/snitt

# A tokenben elvárt audience (kliens azonosító).
# Vesszővel elválasztva több elfogadott audience: minden kliens (landing,
# admin felület, később a desktop app) a saját client id-jével kap tokent.
KEYCLOAK_AUDIENCE=snitt-landing,snitt-admin

# Böngészőből hívó originok, vesszővel elválasztva.
# 5174 = landing, 5175 = admin felület.
CORS_ORIGINS=http://localhost:5174,http://localhost:5175

# --- Admin felület ---

# A Keycloak gyökér URL-je az Admin REST API-hoz (végén nincs perjel).
# Dockerben ez http://keycloak:8080 (az sso-net hálózaton).
KEYCLOAK_BASE_URL=http://localhost:8081

# A realm neve az Admin API útvonalakhoz.
KEYCLOAK_REALM=snitt

# Bizalmas, service accountos kliens, amivel a felhasználókat olvassuk.
# A service accountnak realm-management: view-users (és query-users) kell.
KEYCLOAK_ADMIN_CLIENT_ID=snitt-admin-api
KEYCLOAK_ADMIN_CLIENT_SECRET=snitt-admin-api-dev-secret

# Az a realm szerep, ami az /api/v1/admin/* végpontokat nyitja. Enélkül 403.
ADMIN_ROLE=admin

# Alapértelmezett pénznem az előfizetésekhez és a számlákhoz (ISO 4217).
DEFAULT_CURRENCY=HUF

# --- Hibajelentés (opcionális) ---

# GlitchTip (Sentry-kompatibilis) DSN, a projekt "Client Keys (DSN)" oldaláról. Üresen hagyva
# a hibajelentés teljesen ki van kapcsolva. Helyben futó szolgáltatásnak a "localhost" jó;
# Dockerben "host.docker.internal" kell.
SENTRY_DSN=

# A környezet neve az eseményeken (élesben a compose production-t állít).
SENTRY_ENVIRONMENT=development

# A kiadás azonosítója az eseményeken (opcionális).
# SENTRY_RELEASE=

# --- Online fizetés (opcionális) ---

# Stripe titkos kulcs (sk_live_... / sk_test_...). Üresen hagyva az online
# fizetés ki van kapcsolva: a POST /api/v1/checkout 501-et ad, és minden
# előfizetés kézi admin döntés marad.
STRIPE_SECRET_KEY=

# A webhook aláíró titka (whsec_...). A Stripe Dashboardon a webhook végpont:
#   https://api.snitt.video/api/v1/billing/webhook
# Események: checkout.session.completed, checkout.session.async_payment_succeeded,
# customer.subscription.updated,
# customer.subscription.deleted, invoice.paid
STRIPE_WEBHOOK_SECRET=

# A Stripe-ban létrehozott árak azonosítói (price_...). A havi ár
# ismétlődő (havi), a lifetime egyszeri legyen.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_LIFETIME=
# Opcionális AI csomagok: a havi AI csomag (2 990 Ft / hó, 1 000 000 Snitt AI
# token periódusonként) ismétlődő, az AI tokencsomag (1 990 Ft, 500 000 token,
# nem jár le) egyszeri ár legyen. Üresen hagyva az adott csomag nem jelenik
# meg a GET /api/v1/plans-ban, és a checkout 501-et ad rá.
STRIPE_PRICE_AI_MONTHLY=
STRIPE_PRICE_AI_TOKENS=
# A termékeken adókód: txcd_10202000 (letölthető szoftver, személyes
# használat); az árak adózási módja "inclusive", hogy az ár a végösszeg legyen.

# Managed Payments: a Stripe a kereskedő (merchant of record) - országonként
# számolja és befizeti az áfát, kiállítja a számlát, kezeli a vitás ügyeket
# (+3,5% tranzakciónként). "false" esetén mi vagyunk a kereskedő, és a
# Checkout saját Stripe-számlát állít ki a lifetime vásárlásról.
# A webhook végpont API-verziója 2025-03-31.basil legyen (ezt küldjük mi is).
STRIPE_MANAGED_PAYMENTS=true

# Ide tér vissza a böngésző a fizetés után.
CHECKOUT_SUCCESS_URL=https://snitt.video/fiok?fizetes=sikeres
CHECKOUT_CANCEL_URL=https://snitt.video/fiok?fizetes=megszakitva

# --- Felhős AI funkciók (opcionális) ---

# Voyage AI kulcs a beágyazásokhoz (POST /api/v1/ai/embed). Üresen a végpont 503.
VOYAGE_API_KEY=
# Anthropic API kulcs a válaszokhoz (POST /api/v1/ai/answer). Üresen a végpont 503.
ANTHROPIC_API_KEY=
# A használt modellek. A Snitt AI token súlytáblája modellenként más
# (docs/ARCHITECTURE.md); ismeretlen modell az Opus súlyát kapja.
AI_EMBED_MODEL=voyage-4
AI_ANSWER_MODEL=claude-opus-5-5
