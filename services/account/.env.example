# Snitt account szolgáltatás - környezeti változók.
# Minden változónak van alapértelmezése, ez a fájl a fejlesztői stackhez illik.

# HTTP figyelési cím.
HTTP_ADDR=:8090

# PostgreSQL kapcsolat. Docker composeban a host neve "postgres".
DATABASE_URL=postgres://snitt:snitt@localhost:5432/snitt?sslmode=disable

# A Keycloak realm issuer URL-je: ennek egyeznie kell a tokenek "iss" claimjével.
KEYCLOAK_ISSUER=http://localhost:8081/realms/snitt

# Opcionális: ha a discovery más címen érhető el, mint az issuer (pl. Dockerben
# a "keycloak" hoszton). Üresen hagyva a KEYCLOAK_ISSUER értékét használja.
# KEYCLOAK_DISCOVERY_URL=http://keycloak:8081/realms/snitt

# A tokenben elvárt audience (kliens azonosító).
# Vesszővel elválasztva több elfogadott audience: minden kliens (landing,
# admin felület, később a desktop app) a saját client id-jével kap tokent.
KEYCLOAK_AUDIENCE=snitt-landing,snitt-admin

# Böngészőből hívó originok, vesszővel elválasztva.
# 5174 = landing, 5175 = admin felület.
CORS_ORIGINS=http://localhost:5174,http://localhost:5175

# --- Admin felület ---

# A Keycloak gyökér URL-je az Admin REST API-hoz (végén nincs perjel).
# Dockerben ez http://keycloak:8081.
KEYCLOAK_BASE_URL=http://localhost:8081

# A realm neve az Admin API útvonalakhoz.
KEYCLOAK_REALM=snitt

# Bizalmas, service accountos kliens, amivel a felhasználókat olvassuk.
# A service accountnak realm-management: view-users (és query-users) kell.
KEYCLOAK_ADMIN_CLIENT_ID=snitt-admin-api
KEYCLOAK_ADMIN_CLIENT_SECRET=snitt-admin-api-dev-secret

# Az a realm szerep, ami az /api/v1/admin/* végpontokat nyitja. Enélkül 403.
ADMIN_ROLE=admin

# Alapértelmezett pénznem az előfizetésekhez és a számlákhoz (ISO 4217).
DEFAULT_CURRENCY=HUF
